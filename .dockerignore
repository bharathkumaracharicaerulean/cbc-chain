# Build artifacts - never copy these, they're huge and invalidate cache
target/
.cargo/registry/
.cargo/git/

# keys/ is intentionally included — Alice's network key is committed so
# the peer-id is deterministic. It is NOT a secret (peer-ids are public).

# Git & IDE
.git/
.gitignore
.kiro/
.DS_Store

# Logs & local runtime data
*.log
node_output_*.log
/tmp/

# Docs & scripts (not needed in image)
docs/
scripts/
*.md
!cbc-node/src/cbc-consensus/README.md

# Test files (not needed for release build)
cbc-node/tests/
cbc-pallets/*/src/tests/
cbc-node/src/cbc-consensus/src/tests/

# Docker files themselves
Dockerfile
docker-entrypoint.sh
render.yaml
docker-compose*.yml

# Build artifacts — never copy these, they're huge and bust the cache
target/
.cargo/registry/
.cargo/git/

# keys/ is intentionally NOT ignored — Alice's network key is committed so
# the peer-id is deterministic across all deployments.

# Git & IDE
.git/
.gitignore
.kiro/
.DS_Store

# Logs & local runtime data
*.log
node_output_*.log

# Docs (not needed in image)
docs/
scripts/
*.md

# Docker files — not needed inside the image build context
# NOTE: docker-entrypoint.sh is intentionally NOT excluded here
#       because the runtime stage COPYs it in.
Dockerfile
render.yaml
docker-compose*.yml
